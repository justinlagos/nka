# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://lftigvxqblwytxtmwmez.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Full site address, used in sign-in and Stripe links. Falls back to the request's own address.
NEXT_PUBLIC_SITE_URL=https://nka.studio
# Optional: your calendar link (Cal.com, Calendly, Google). Shown after a demo request.
NEXT_PUBLIC_BOOKING_URL=
# Shown on the site next to "Book a demo". Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key (Settings > API Keys). Only the Stripe webhook uses it.
SUPABASE_SECRET_KEY=
# Stripe (Developers > API keys, and the webhook's signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Claude drafts briefs. Without a key, briefs are laid out from the client's own words.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if the key was NOT created inside a workspace
ANTHROPIC_WORKSPACE_ID=
# Optional email alerts for new briefs and booking requests (Resend)
RESEND_API_KEY=
NKA_FROM_EMAIL=Nka Studio <nka.studio@motionplaylabs.com>
NKA_NOTIFY_EMAIL=
