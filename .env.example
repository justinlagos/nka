# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://lftigvxqblwytxtmwmez.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Full site address, used in sign-in and Stripe links. Falls back to the request's own address.
NEXT_PUBLIC_SITE_URL=https://nka.studio
# Optional: your calendar link (Cal.com, Calendly, Google). Shown after a demo request.
NEXT_PUBLIC_BOOKING_URL=
# Shown on the site next to "Book a demo". Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase secret key (Settings > API Keys). Used by the Stripe webhook and the support chat.
SUPABASE_SECRET_KEY=
# Stripe (Developers > API keys, and the webhook's signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Claude drafts briefs. Without a key, briefs are laid out from the client's own words.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if the key was NOT created inside a workspace
ANTHROPIC_WORKSPACE_ID=
# Instant (AI) briefs and concept images. Without a key, Instant is hidden and concepts are skipped.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
# low | medium | high (default medium)
IMAGE_QUALITY=medium
# Protects the daily reminder job (Vercel sends it automatically once set).
CRON_SECRET=
# Optional email alerts for new briefs and booking requests (Resend)
RESEND_API_KEY=
NKA_FROM_EMAIL=Nka Studio <nka.studio@motionplaylabs.com>
NKA_NOTIFY_EMAIL=

# Abigail, the support assistant in the client workspace (Custard AI). See README, "Support chat".
# The Help button shows only when the API key, staff ID, identity secret and SUPABASE_SECRET_KEY are set.
CUSTARD_API_KEY=
CUSTARD_STAFF_ID=
# Long random string. The same value goes into Custard > Developers > Live lookup.
CUSTARD_LOOKUP_SECRET=
# Long random string that never leaves the server. Signs the id Abigail knows each client by.
CUSTARD_IDENTITY_SECRET=
# From Custard > Developers > Webhook, after tapping Connect.
CUSTARD_SIGNING_SECRET=
